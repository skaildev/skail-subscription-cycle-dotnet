<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- runs on a newer .NET runtime when 8 is not installed -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Skail.Platform.Runtime" Version="2.3.0-rc.4" />
    <PackageReference Include="Skail.Platform.Analyzer" Version="2.3.0-rc.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Page/index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
